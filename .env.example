# Copy to .env.local for local development. Never commit real values.
# Production and preview values are set in the Vercel project settings.

# Contact form delivery through Resend (PTR-27, ADR 0003).
# The destination inbox; never shown on the site.
CONTACT_TO_EMAIL=
# A sender on the domain verified in Resend.
CONTACT_FROM_EMAIL=
# Resend API key with sending access only.
EMAIL_PROVIDER_API_KEY=

# Public site URL, used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Test only: "test" skips the network in the e2e suite. Ignored in production.
# Never set this in Vercel.
# CONTACT_TRANSPORT=
